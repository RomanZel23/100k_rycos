# company-admin environment.
# On the server this lives at /root/company-admin.env and is copied to .env on deploy.

# Supabase (anon key is public — safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://kjdpdjsspodygfzphozg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# admin-api base URL used by server-side calls (signup, data fetches).
# On the server use the loopback port to avoid a public round-trip.
ADMIN_API_URL=http://127.0.0.1:9504

# URL of the Flutter vendor app (products / POS / orders). Same Supabase login.
# When set, a "Product management ↗" link appears in the dashboard sidebar.
NEXT_PUBLIC_VENDOR_APP_URL=
