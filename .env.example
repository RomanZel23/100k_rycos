# =============================================================================
# 100k_rycos - Environment Configuration (Coolify & Supabase)
# =============================================================================

# Host Ports Mapping
API_HOST_PORT=8008 # Host port for API (ports 8000 and 8080 are in use on host)
WEB_HOST_PORT=3000 # Host port for customer-web
HOST=0.0.0.0
NODE_ENV=production

# Supabase Database (PostgreSQL 15/16/17 via Coolify internal network or direct URL)
# Example internal Coolify network: postgresql://postgres:YOUR_PASSWORD@supabase-db:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_MAX_CONNECTIONS=50

# Supabase Auth & JWT
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis (Coolify standalone Redis instance)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RYCOS Fiscal Hub & MQTT Integration
RYCOS_MQTT_HOST=rycos.eu
RYCOS_MQTT_PORT=8883
RYCOS_MQTT_USERNAME=rycos_yallaorder
RYCOS_MQTT_PASSWORD=your_rycos_mqtt_password
RYCOS_DEFAULT_DISPLAY_ID=SBT-NMLL2M
RYCOS_PORTAL_API_URL=https://portal.rycos.eu/api/v2
RYCOS_WEBHOOK_SECRET=your_rycos_webhook_secret

# Payments (Saferpay / BLIK / Cards)
SAFERPAY_CUSTOMER_ID=
SAFERPAY_TERMINAL_ID=
SAFERPAY_API_USERNAME=
SAFERPAY_API_PASSWORD=
SAFERPAY_TEST_MODE=true

# Next.js Customer Web
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com/v1/ws
NEXT_PUBLIC_DEFAULT_CURRENCY=PLN
